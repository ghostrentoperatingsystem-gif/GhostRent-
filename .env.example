# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Generative AI
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GOOGLE_GENERATIVE_AI_KEY=your_google_api_key_here

# Application Environment
NODE_ENV=development
# NODE_ENV can be: development, production, test

# Database
# Add database connection strings if using a separate database
# DATABASE_URL=

# API Configuration
# Add any other API endpoints or configurations
# API_BASE_URL=

# Feature Flags
# NEXT_PUBLIC_FEATURE_FLAG_NAME=true
